# 复制为 .env 后按需修改：cp .env.example .env

# 宿主机端口映射
POSTGRES_PORT=15432
API_PORT=8080
WEB_PORT=5173
ADMINER_PORT=8081

# ha-api
HA_ADMIN_PASSWORD=123456qq
HA_NODE_TOKEN=ha-test-node-token-2026
HA_INTERNAL_TOKEN=internal-dev
HA_JWT_SECRET=dev-insecure-change-me-please-32b
# memory = 本机模拟 Workspace；非 memory 时走 RemoteAgent（需 PVE agent 或 mock-agents）
HA_RUNTIME=remote
# PVE 实验室未启 EasyTier 时，API 经节点 lan_ip 调 ha-agent :9091
HA_AGENT_VIA_LAN=1
# 控制台展示的 SSH/SCP 跳板地址（本地实验室勿用生产域名）
HA_BASTION_HOST=127.0.0.1
HA_BASTION_PORT=8099
# 实验室未部署跳板时，控制台展示节点直连 SSH（随 HA_AGENT_VIA_LAN=1 默认开启）
HA_BASTION_DIRECT=1
HA_SEED=1

# 集成测试：逗号分隔期望在线的节点名；留空则只校验 heartbeat 探针
# HA_EXPECT_NODES=ha-test-01,ha-test-02,ha-test-03
