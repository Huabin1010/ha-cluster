# ==========================================
# ha-cluster Docker 环境变量配置
# ==========================================

# 镜像地址配置
HA_API_IMAGE=ghcr.io/huabin1010/ha-cluster/ha-api:latest

# 宿主机映射端口（例如配合 OpenResty 或 1Panel）
HA_HOST_PORT=18082

# 服务监听地址（容器内）
HA_API_ADDR=:8080

# JWT 密钥（生产环境请务必替换为随机强密码，至少 32 字符）
HA_JWT_SECRET=dev-insecure-change-me-please-32b

# 无管理员时自动创建的 admin 密码（默认 adminadmin）
HA_ADMIN_PASSWORD=adminadmin

# 设为 0 关闭启动时自动创建 admin（仍可通过注册首个用户获得管理员）
# HA_SEED=0

# 数据库连接串（留空则默认使用内存存储 memory store）
# 示例 PostgreSQL: postgres://ha:ha_password@postgres:5432/ha_cluster?sslmode=disable
DATABASE_URL=

# 节点注册与内部通信 Token
HA_NODE_TOKEN=
HA_INTERNAL_TOKEN=

# 堡垒机 SSH 端口
HA_BASTION_PORT=2222

# 工作区运行时类型（memory 或 incus）
HA_RUNTIME=memory
