{
  "name": "ha-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:pw1": "playwright test --grep @pw1",
    "test:e2e:pw2": "playwright test --grep @pw2",
    "test:e2e:pw3": "playwright test --grep @pw3",
    "test:e2e:pw4": "playwright test --grep @pw4",
    "test:e2e:pw5": "playwright test --grep @pw5",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:real": "playwright test --config playwright.real.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@refinedev/core": "^4.57.9",
    "@refinedev/react-router-v6": "^4.6.2",
    "@tanstack/react-query": "^5.102.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.4",
    "vitest": "^3.1.2"
  }
}
