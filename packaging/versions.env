# Frozen third-party versions for offline payloads (T3).
# Sourced by fetch-deps.sh and pack.sh — edit here, not in scripts.

K3S_VERSION="v1.36.4+k3s1"
EASYTIER_VERSION="v2.6.4"

# Workspace base image (official Ubuntu cloud rootfs; Incus-importable).
UBUNTU_CLOUD_SERIES="24.04"
UBUNTU_CLOUD_CODENAME="noble"

# Host OS deb caches shipped beside the payload.
DEB_SUITES="jammy resolute"
DEB_PACKAGES="uidmap"

# Incus (Zabbly stable) offline debs — one directory per host suite under cache/.../incus/<suite>/debs/
INCUS_ZABBLY_SUITES="jammy noble resolute"

# Payload release label (appears in manifest / VERSIONS.md).
PAYLOAD_VERSION="0.1.0"
