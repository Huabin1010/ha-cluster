{
  "name": "ha-cluster-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:api": "bun scripts/dev.ts --api",
    "dev:web": "bun --filter ha-web dev",
    "build:web": "bun --filter ha-web build",
    "test:web": "bun --filter ha-web test",
    "test:go": "go test ./...",
    "test": "bun run test:go && bun run test:web"
  }
}
