# Copy to /etc/ha-cluster/easytier.env (mode 600). Do NOT put these in api.env.
# Secrets also live in docs/credentials.local.md (gitignored).

HA_ET_ROLE=hub
HA_ET_VERSION=2.6.4
HA_ET_NET=ha-c1
HA_ET_SECRET=replace-with-strong-secret
HA_ET_IPV4=10.88.0.1/16
HA_ET_INSTANCE=et-vps-1
HA_ET_DEV=easytier

# Hub listeners (quoted, space-separated). Official public shared nodes stay OFF.
HA_ET_LISTENERS="udp://0.0.0.0:11010 tcp://0.0.0.0:11010 wss://0.0.0.0:11011"
# leave HA_ET_PEERS unset on hub (do not set empty peers="")

# --- client example (dev-pc trial) ---
# HA_ET_ROLE=client
# HA_ET_IPV4=10.88.0.30/16
# HA_ET_INSTANCE=et-dev-pc
# HA_ET_LISTENERS=
# HA_ET_PEERS="tcp://server.mnnumath.vip:11010 wss://server.mnnumath.vip:11011"
