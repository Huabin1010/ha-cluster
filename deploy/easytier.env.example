# Copy to /etc/ha-cluster/easytier.env (mode 600). Do NOT put these in api.env.
# Secrets also live in docs/credentials.local.md (gitignored).
# Fabric 定稿见 .cursor/rules/easytier-fabric.mdc

HA_ET_ROLE=hub
HA_ET_VERSION=2.6.4
HA_ET_NET=ha-cluster-easytier
HA_ET_SECRET=replace-with-strong-secret
HA_ET_IPV4=10.129.129.1/24
HA_ET_INSTANCE=et-vps-1
HA_ET_DEV=easytier

# Hub listeners (quoted, space-separated). Official public shared nodes stay OFF.
HA_ET_LISTENERS="udp://0.0.0.0:15010 tcp://0.0.0.0:15010"
# leave HA_ET_PEERS unset on hub (do not set empty peers="")

# --- client example (PVE ha-test-01) ---
# HA_ET_ROLE=client
# HA_ET_IPV4=10.129.129.205/24
# HA_ET_INSTANCE=et-ha-test-01
# HA_ET_LISTENERS=
# HA_ET_PEERS="udp://110.40.229.62:15010 tcp://110.40.229.62:15010"
