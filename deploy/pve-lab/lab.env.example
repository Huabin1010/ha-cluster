# 复制为 lab.env 并填写 HA_ET_SECRET（与 Hub 一致，见 docs/credentials.local.md）
# 勿提交 lab.env

# Depot 公网根（pve-lab 离线包）
DEPOT_PUBLIC=https://rustfs.s.ggss.club:50000/typora/ha-cluster

# PVE 宿主机（SSH 信任已配置）
PVE_HOST=192.168.1.8
PVE_USER=root

# 控制面 API（Docker dev 或本机 go run）
HA_API_BASE=http://192.168.1.100:8080
HA_NODE_TOKEN=ha-test-node-token-2026

# EasyTier Fabric（见 .cursor/rules/easytier-fabric.mdc）
HA_ET_NET=ha-cluster-easytier
HA_ET_SECRET=replace-with-hub-secret
HA_ET_VERSION=v2.6.4
HA_ET_PEERS="udp://110.40.229.62:15010 tcp://110.40.229.62:15010"

# Worker 可选
HA_INCUS_IMAGE=ha-ubuntu-24.04
SKIP_INCUS=0
SKIP_EASYTIER=0
