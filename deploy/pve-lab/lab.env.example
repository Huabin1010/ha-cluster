# 复制为 lab.env 并填写 HA_ET_SECRET（与 Hub 一致，见 docs/credentials.local.md）
# 勿提交 lab.env

# Depot 根 URL（实验室默认局域网 RustFS，与公网同 bucket/键布局）
DEPOT_PUBLIC=http://192.168.1.9:10000/typora/ha-cluster
# 公网（生产 join / 外网验证）：https://rustfs.s.ggss.club:50000/typora/ha-cluster

# PVE 宿主机（仅 SSH / qm guest exec，不在 PVE 上部署 Depot 或 HTTP 镜像）
PVE_HOST=192.168.1.8
PVE_USER=root

# 控制面 API（Docker dev 或本机 go run）
HA_API_BASE=http://192.168.1.100:8080
HA_NODE_TOKEN=ha-test-node-token-2026
# ha-api 环境变量：控制台 SSH/SCP 展示的跳板（写入 docker/dev/.env）
# HA_BASTION_HOST=192.168.1.100
# HA_BASTION_PORT=8099

# EasyTier Fabric（见 .cursor/rules/easytier-fabric.mdc）
HA_ET_NET=ha-cluster-easytier
HA_ET_SECRET=replace-with-hub-secret
HA_ET_VERSION=v2.6.4
HA_ET_PEERS="udp://192.168.1.60:15010 tcp://192.168.1.60:15010"

# Worker：Incus 离线（Depot）+ 系统 apt 清华源
HA_INCUS_IMAGE=ha-ubuntu-24.04
HA_INSTALL_MODE=offline
HA_APT_MIRROR=tuna
SKIP_INCUS=0
SKIP_EASYTIER=0
