# 非敏感默认配置（随 pve-lab 包发布到 Depot，不含密钥）
HA_API_BASE=http://192.168.1.60:8080
HA_NODE_TOKEN=ha-test-node-token-2026
HA_ET_NET=ha-cluster-easytier
HA_ET_VERSION=v2.6.4
HA_ET_PEERS="udp://192.168.1.60:15010 tcp://192.168.1.60:15010"
HA_INCUS_IMAGE=ha-ubuntu-24.04
# Incus 走 Depot 离线包；系统 apt / docker bake 走清华源
HA_INSTALL_MODE=offline
HA_APT_MIRROR=tuna
SKIP_INCUS=1
SKIP_EASYTIER=0
# 实验室无外网 egress 时跳过 Incus 容器 ping 8.8.8.8
HA_VERIFY_EGRESS=0
