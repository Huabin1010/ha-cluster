[Unit]
Description=ha-cluster bastion sshd (port 8099)
Documentation=file:///etc/ssh/sshd_config_bastion
After=network.target ha-api.service
Wants=ha-api.service

[Service]
EnvironmentFile=-/etc/ha-cluster/bastion.env
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/sshd_config_bastion
ExecStart=/usr/sbin/sshd -D -f /etc/ssh/sshd_config_bastion -e
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
