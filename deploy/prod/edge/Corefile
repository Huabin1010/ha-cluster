# Split-horizon for EasyTier clients.
# Same public names resolve to the control/edge VIP so HTTPS/HTTP
# stays on the overlay (no 42 public NIC). Other names are forwarded.
cl.qzsyzn.com:53 {
    bind 0.0.0.0
    template IN A {
        answer "{{ .Name }} 30 IN A 10.129.129.253"
    }
}

.:53 {
    bind 0.0.0.0
    forward . 223.5.5.5 8.8.8.8
}
