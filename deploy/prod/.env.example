# 生产控制面环境变量模板 — 复制为 .env 后填实值，勿提交 .env
HA_API_IMAGE=ghcr.io/huabin1010/ha-cluster/ha-api:latest
HA_HOST_PORT=18082

HA_JWT_SECRET=CHANGE_ME_TO_RANDOM_32PLUS_CHARS
HA_ADMIN_PASSWORD=123456qq
HA_SEED=1

POSTGRES_USER=ha
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=ha
DATABASE_URL=postgres://ha:CHANGE_ME_DB_PASSWORD@postgres:5432/ha?sslmode=disable

HA_NODE_TOKEN=CHANGE_ME_NODE_TOKEN
HA_ET_SECRET=CHANGE_ME_EASYTIER_NETWORK_SECRET
HA_INTERNAL_TOKEN=CHANGE_ME_INTERNAL_TOKEN

HA_BASTION_HOST=bastion.cl.qzsyzn.com
HA_BASTION_PORT=8099
HA_RUNTIME=incus

# 内置 HTTPS / ACME（DNS-01 通配符，自动续期）
HA_ACME_EMAIL=admin@cl.qzsyzn.com
HA_ACME_ROOT_DOMAIN=qzsyzn.com
HA_TLS_DIR=/var/lib/ha-cluster/tls
# HA_ACME_STAGING=1
# HA_DNSPOD_ID=
# HA_DNSPOD_TOKEN=
# 签发后挂到宝塔站点（容器内走宿主机网关）
# HA_BT_PANEL=http://host.docker.internal:8888
# HA_BT_KEY=
# HA_BT_SSL_SITE=apps.cl.qzsyzn.com

# 自有域名 CNAME 接入（免审）。先在 DNSPod 加 edge.cl.qzsyzn.com 与 *.edge.cl.qzsyzn.com → 42 的 A 记录
# HA_INGRESS_CNAME_TARGETS=edge.cl.qzsyzn.com
# baota = 每个自有域建宝塔站点 + 反代到 edge + Let's Encrypt；noop = 只开 HTTP
# HA_EDGE_PROVIDER=baota
# HA_BT_EDGE_TARGET=http://127.0.0.1:18080
# HA_BT_SITE_ROOT=/www/wwwroot
# 校验用的公共 DNS（逗号分隔，默认 223.5.5.5,119.29.29.29）
# HA_INGRESS_DNS_SERVERS=
